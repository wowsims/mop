{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "useTabs": true,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./ui/styles/style.css",
    "functions": ["clsx"],
    "attributes": [
      "bodyClassName",
      "cellClassName",
      "clearClassName",
      "iconClassName",
      "inputClassName",
      "labelClassName",
      "rowClassName",
      "selectClassName",
      "triggerClassName"
    ]
  },
  "ignorePatterns": [
    "ui/worker/highs.js",
    "ui/**/apls/*.apl.json",
    "ui/**/builds/*.build.json",
    "ui/**/gear_sets/*.gear.json",
    "ui/**/presets/**/*.json",
    "ui/sim/talents/trees/*.json"
  ]
}
