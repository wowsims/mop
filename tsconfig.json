{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"lib": ["DOM", "es2021", "DOM.Iterable"],
		"outDir": "dist/mop",
		"pretty": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"types": ["node", "gtag.js", "golang-wasm-exec"],
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"skipLibCheck": true,
		"paths": {
			"@domain/*": ["./ui/domain/*"],
			"@generated/*": ["./ui/generated/*"],
			"@worker/*": ["./ui/worker/*"],
			"@ui-kit/*": ["./ui/ui-kit/*"],
			"@features/*": ["./ui/features/*"],
			"@app/*": ["./ui/app/*"],
			"@specs/*": ["./ui/sims/*"],
			"@i18n/*": ["./ui/i18n/*"],
			"@jsx-vanilla/*": ["./ui/shared/jsx-vanilla/*"]
		}
	},
	"include": ["."],
	"exclude": ["node_modules", "dist", "binary_dist", ".history", "ui/generated/proto/*"]
}
